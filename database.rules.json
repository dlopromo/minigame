{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      ".read": "auth != null",
      ".indexOn": ["createdAt"],
      "$roomCode": {
        ".read": "auth != null && $roomCode.matches(/^[0-9]{4}$/)",
        ".write": "auth != null && $roomCode.matches(/^[0-9]{4}$/)",
        ".validate": "newData.hasChildren(['hostId', 'status', 'createdAt', 'updatedAt'])",
        "hostId": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9-]{8,80}$/)"
        },
        "hostEpoch": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999"
        },
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(lobby|starting|playing|closed)$/)"
        },
        "gameId": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "mode": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "roundId": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "maxPlayers": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 8"
        },
        "activeGameId": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "activeMode": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "members": {
          "$clientId": {
            ".validate": "$clientId.matches(/^[A-Za-z0-9-]{8,80}$/) && newData.hasChildren(['name', 'role', 'online', 'authUid'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 12 && newData.val().matches(/^[A-Za-z0-9\\u4e00-\\u9fff]+$/)"
            },
            "role": {
              ".validate": "newData.val() === 'host' || newData.val() === 'member'"
            },
            "online": {
              ".validate": "newData.isBoolean()"
            },
            "presence": {
              ".validate": "newData.isString() && newData.val().matches(/^(lobby|playing|spectating)$/)"
            },
            "queueStatus": {
              ".validate": "newData.isString() && newData.val().matches(/^(none|queued)$/)"
            },
            "authUid": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "lastSeenAt": {
              ".validate": "newData.isNumber()"
            },
            "connectionVersion": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "queue": {
          "$clientId": {
            ".validate": "$clientId.matches(/^[A-Za-z0-9-]{8,80}$/) && newData.hasChildren(['name', 'queuedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 12 && newData.val().matches(/^[A-Za-z0-9\\u4e00-\\u9fff]+$/)"
            },
            "queuedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "chat": {
          "$messageId": {
            ".validate": "newData.hasChildren(['from', 'name', 'text', 'createdAt'])",
            "from": {
              ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9-]{8,80}$/)"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 12 && newData.val().matches(/^[A-Za-z0-9\\u4e00-\\u9fff]+$/)"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
            },
            "createdAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "players": {
          "$clientId": {
            ".validate": false
          }
        },
        "spectators": {
          "$clientId": {
            ".validate": false
          }
        },
        "gameActions": {
          "$actionId": {
            ".validate": "newData.hasChildren(['from', 'roundId', 'payload', 'createdAt'])",
            "from": {
              ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9-]{8,80}$/)"
            },
            "roundId": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
            },
            "gameId": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "mode": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "payload": {
              ".validate": "newData.exists()"
            },
            "createdAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "gameStart": {
          ".validate": "newData.val() === null || newData.hasChildren(['gameId', 'mode', 'roundId', 'hostId', 'players', 'spectators', 'rolesByClientId', 'initialState'])"
        },
        "gameState": {
          ".validate": "newData.val() === null || newData.hasChildren(['gameId', 'mode', 'roundId', 'state', 'updatedBy', 'updatedAt'])"
        },
        "currentRound": {
          ".validate": "newData.val() === null || newData.hasChildren(['gameId', 'mode', 'roundId', 'players', 'spectators', 'startedAt'])"
        },
        "history": {
          "$entryId": {
            ".validate": "newData.hasChildren(['gameId', 'roundId', 'status', 'createdAt'])"
          }
        },
        "leaderboard": {
          "$playerId": {
            ".validate": true
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
